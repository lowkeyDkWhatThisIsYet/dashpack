# Copy to .env.local, fill in credentials, and restart the dashboard.
# Optional: set a stable secret of at least 32 characters.
# When omitted, a secret is generated and retained in .data/auth/secret.
# BETTER_AUTH_SECRET=

# Register these exact callback URLs in the respective OAuth applications:
# Google: http://127.0.0.1:3001/api/auth/callback/google
# GitHub: http://127.0.0.1:3001/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
